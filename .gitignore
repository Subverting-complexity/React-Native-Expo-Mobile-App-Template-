# Store-publishing secrets and generated fastlane files — NEVER commit the
# secrets. pc-api-key.json is the Play service-account key; report.xml and
# fastlane/README.md are auto-generated by fastlane runs; _preview holds
# local screenshot drafts pending review.
pc-api-key.json
fastlane/.env*
fastlane/report.xml
fastlane/README.md
fastlane/creative/_preview/
**/.fastlane/

# Metro
.metro-health-check*

# macOS
.DS_Store
*.pem

# Local env files — never commit real tokens. Holds EXPO_TOKEN (per-repo Expo
# auth); .env.example is the committed, token-less template.
.env
.env*.local
!.env.example

# TypeScript
*.tsbuildinfo

# Test coverage
coverage/

# Local Claude Code / AI-assistant state (not part of the project)
.claude/

# Python bytecode (from the fastlane screenshot generator)
__pycache__/

# Local graphify knowledge-graph output
graphify-out/

# Release bookkeeping the deploy scripts write between start and finish.
# Must stay untracked: a tracked file a release writes would make the next
# release's clean-tree check fail on the previous release's bookkeeping.
tools/release/release-state.json

